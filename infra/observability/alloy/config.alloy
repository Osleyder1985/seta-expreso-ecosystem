logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "seta_expresso" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "seta_expresso_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "seta_expreso" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.seta_expreso.targets
  labels        = { job = "docker" }
  relabel_rules = discovery.relabel.seta_expresso_logs.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
